# Dữ liệu (nguồn thô, lớp trung gian, đầu ra chunk/embedding, cache, ảnh): KHÔNG commit. Sinh lại được từ code + configs.
data/

# Bí mật và môi trường
.env
.env.*
!.env.example
.venv/
venv/

# Rác của Python / công cụ
__pycache__/
*.pyc
.pytest_cache/
.codegraph/
.claude/

# Sao lưu/tạm do giao diện duyệt và script ghi
configs/*.bak
configs/*.tmp
*.log

# Word lock files
~$*

# Sao lưu/tạm khác của cấu hình
configs/*.bak*

# Cache công cụ, IDE, hệ điều hành
.mypy_cache/
.ruff_cache/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build/giao diện (đã có trong frontend/.gitignore, thêm ở gốc cho chắc)
frontend/node_modules/
frontend/.next/
frontend/.env*.local
frontend/next-env.d.ts


CLAUDE.md
.agent/
frontend/AGENTS.md