{
  "openapi": "3.1.0",
  "info": {
    "title": "sAR - Student Academic RAG API",
    "description": "\nAPI cho hệ thống hỏi đáp học vụ **sAR - Student Academic RAG** (Trường ĐH Thăng Long).\n\n* `POST /chat`: hỏi đáp (tuần 3 trả câu trả lời **mock**, đã lưu DB thật)\n* `GET /conversations/{id}`: lịch sử hội thoại\n* `POST /feedback`: đánh giá câu trả lời\n* `GET /suggestions`: câu hỏi gợi ý\n* `GET /search`: tìm kiếm **thật** trên Qdrant (bọc retriever của nhóm AI)\n",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Kiểm tra API còn sống",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Kiểm tra kết nối PostgreSQL, Qdrant, Redis",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL không kết nối được",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Gửi câu hỏi, nhận câu trả lời kèm nguồn (tuần 3: MOCK)",
        "description": "Bỏ trống `conversation_id` để tạo hội thoại mới.\n\nKhi `stream=true`, phản hồi là `text/event-stream` gồm các sự kiện theo thứ tự:\n\n| event | data (JSON) |\n|---|---|\n| `start` | `{\"conversation_id\", \"message_id\"}` |\n| `token` | `{\"delta\": \"<một đoạn chữ>\"}` (lặp nhiều lần) |\n| `citations` | `{\"citations\": [Citation...]}` |\n| `done` | toàn bộ `ChatResponse` |\n| `error` | `{\"detail\": \"...\"}` (chỉ khi lỗi giữa chừng) |",
        "operationId": "chat_api_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              },
              "text/event-stream": {}
            }
          },
          "404": {
            "description": "conversation_id không tồn tại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations/{conversation_id}": {
      "get": {
        "tags": [
          "conversations"
        ],
        "summary": "Lấy toàn bộ tin nhắn của một cuộc hội thoại (kèm nguồn và feedback)",
        "operationId": "get_conversation_api_v1_conversations__conversation_id__get",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationOut"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/feedback": {
      "post": {
        "tags": [
          "feedback"
        ],
        "summary": "Đánh giá một câu trả lời (up/down). Gửi lại sẽ cập nhật đánh giá cũ",
        "operationId": "create_feedback_api_v1_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackOut"
                }
              }
            }
          },
          "200": {
            "description": "Đã cập nhật đánh giá có sẵn",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedbackOut"
                }
              }
            }
          },
          "404": {
            "description": "message_id không tồn tại",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Chỉ đánh giá được tin nhắn của assistant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/suggestions": {
      "get": {
        "tags": [
          "suggestions"
        ],
        "summary": "Câu hỏi gợi ý cho màn hình chat",
        "operationId": "suggestions_api_v1_suggestions_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 6,
              "title": "Limit"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "dang_ky_hoc_phan | hoc_phi | tot_nghiep | hoc_bong | thu_tuc | lich_thi",
              "title": "Category"
            },
            "description": "dang_ky_hoc_phan | hoc_phi | tot_nghiep | hoc_bong | thu_tuc | lich_thi"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuggestionsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Tìm đoạn tài liệu liên quan trong vector DB (không qua LLM)",
        "operationId": "search_api_v1_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "Câu hỏi / từ khóa",
              "title": "Q"
            },
            "description": "Câu hỏi / từ khóa"
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Số kết quả (mặc định 5, tối đa 20)",
              "title": "Top K"
            },
            "description": "Số kết quả (mặc định 5, tối đa 20)"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Lọc theo nhóm tài liệu, truyền nhiều lần được",
              "title": "Category"
            },
            "description": "Lọc theo nhóm tài liệu, truyền nhiều lần được"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "503": {
            "description": "Qdrant chưa sẵn sàng / chưa có dữ liệu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatFilters": {
        "properties": {
          "categories": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Categories",
            "description": "Chỉ tìm trong các nhóm tài liệu này (vd. quy_che, hoc_phi, lich_thi)",
            "examples": [
              [
                "quy_che",
                "hoc_phi"
              ]
            ]
          }
        },
        "type": "object",
        "title": "ChatFilters"
      },
      "ChatRequest": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "Bỏ trống để bắt đầu cuộc hội thoại mới"
          },
          "message": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "examples": [
              "Điều kiện xét tốt nghiệp là gì?"
            ]
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id",
            "description": "Mã người dùng/phiên (tùy chọn)"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "Số nguồn tối đa dùng để trả lời",
            "default": 5
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatFilters"
              },
              {
                "type": "null"
              }
            ]
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "description": "true: trả về Server-Sent Events (text/event-stream) thay vì JSON",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id",
            "description": "id tin nhắn trả lời, dùng khi gửi POST /feedback"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationOut"
            },
            "type": "array",
            "title": "Citations"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "mode": {
            "type": "string",
            "enum": [
              "mock",
              "rag"
            ],
            "title": "Mode",
            "description": "mock: câu trả lời giả lập (tuần 3)"
          }
        },
        "type": "object",
        "required": [
          "conversation_id",
          "message_id",
          "answer",
          "citations",
          "created_at",
          "mode"
        ],
        "title": "ChatResponse"
      },
      "CitationOut": {
        "properties": {
          "rank": {
            "type": "integer",
            "title": "Rank",
            "description": "Thứ tự nguồn, dùng để hiển thị [1], [2]... trong câu trả lời"
          },
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "doc_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "snippet": {
            "type": "string",
            "title": "Snippet",
            "description": "Đoạn trích của tài liệu nguồn"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "metadata": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "rank",
          "chunk_id",
          "snippet"
        ],
        "title": "CitationOut"
      },
      "ConversationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageOut"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "user_id",
          "created_at",
          "updated_at",
          "messages"
        ],
        "title": "ConversationOut"
      },
      "ErrorResponse": {
        "properties": {
