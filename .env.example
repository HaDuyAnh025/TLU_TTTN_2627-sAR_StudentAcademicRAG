# ===== Mẫu biến môi trường. Copy thành .env (KHÔNG commit .env) =====

# --- PostgreSQL ---
POSTGRES_USER=sar
POSTGRES_PASSWORD=sar_password
POSTGRES_DB=sar
POSTGRES_PORT=5432
# Dùng khi chạy API ngoài Docker (trong Docker, docker-compose.yml tự đặt lại host = postgres)
DATABASE_URL=postgresql+psycopg://sar:sar_password@localhost:5432/sar

# --- Redis (để trống REDIS_URL= để tắt cache) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
SEARCH_CACHE_TTL=300

# --- Qdrant ---
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sar_chunks

# --- Embedding: PHẢI giống mô hình dùng khi index (thống nhất với T3-03 / T3-05) ---
# sentence_transformers: mô hình thật | hash: giả lập theo từ khóa, chỉ để thử API
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# e5: "query: " / "passage: ";  BGE-M3, Vietnamese SBERT: để trống
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# INSTALL_ML=false để build image nhẹ (khi đó phải dùng EMBEDDING_PROVIDER=hash)
INSTALL_ML=true

# --- API ---
API_PORT=8000
ENVIRONMENT=dev
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SEARCH_DEFAULT_TOP_K=5
SEARCH_MAX_TOP_K=20
CHAT_MODE=mock
MOCK_STREAM_DELAY_MS=30

# --- LLM (dùng từ tuần 4, T4-05) ---
# OPENAI_API_KEY=
# LLM_MODEL=
